# ---- Alebex (required) ----------------------------------------------------
# In the console at https://app.alebex.ai/dev, under the Voice API key, press
# the ".env file" button. It downloads a ready .env holding your keys and the
# two hosts below. Drop that file in this folder instead of copying this one.
ALEBEX_API_KEY=wt_replace_me
ALEBEX_API_URL=https://api.alebex.ai/api/v1
ALEBEX_ENGINE_URL=https://api.voice.alebex.ai

# The download does NOT include the agent id: open your agent in the console
# and add this one line yourself.
ALEBEX_AGENT_ID=replace_me

# The download also carries these two speech-to-text values. Nothing in this
# starter uses them; leave them alone.
# ALEBEX_ASR_API_KEY=wt_...
# ALEBEX_ASR_URL=wss://...

# ---- Webhook signing secret (optional) ------------------------------------
# When you add this project's /api/alebex/end-of-call address on the console's
# Webhooks page, turn signing on. The console shows the secret once. Without it
# the route cannot tell a real call report from one anybody posted to your URL.
ALEBEX_WEBHOOK_SECRET=

# ---- Your tool's own secret (required) ------------------------------------
# You invent this one. Any long random string. It proves a tool request really
# came from your agent and not from a stranger who found your URL.
TOOL_SECRET=replace_me_with_a_long_random_string

# ---- Public base URL (required once you deploy) ---------------------------
# Where your tools live on the internet. Alebex must be able to reach it, so
# localhost will not work. Fill this in after your first Vercel deploy.
PUBLIC_BASE_URL=https://your-project.vercel.app

# ---- Twilio (optional) ----------------------------------------------------
# Only needed to place a real phone call. Your agent works in code without it.
# See the optional Twilio side quest in the workshop.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
